NODE_ENV=development
BACKEND_PORT=3010
FRONTEND_URL=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deployguard
POSTGRES_PASSWORD=deployguard_password
